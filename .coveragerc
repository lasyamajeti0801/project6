[run]
branch = True
source = backend/apps
omit =
    */migrations/*
    */tests/*
    backend/stockpilot/wsgi.py
    backend/stockpilot/asgi.py

[report]
show_missing = True
precision = 2
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:

[html]
directory = coverage_html

[xml]
output = coverage.xml
